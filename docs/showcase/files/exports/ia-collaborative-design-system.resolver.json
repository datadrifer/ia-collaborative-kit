{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "version": "2025.10",
  "name": "IA Collaborative 1.0.0",
  "description": "Base tokens, then the colour roles for the chosen theme.",
  "sets": {
    "base": {
      "sources": [
        {
          "$ref": "base.tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "theme": {
      "contexts": {
        "light": [
          {
            "$ref": "light.tokens.json"
          }
        ],
        "dark": [
          {
            "$ref": "dark.tokens.json"
          }
        ]
      },
      "default": "light"
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/base"
    },
    {
      "$ref": "#/modifiers/theme"
    }
  ]
}